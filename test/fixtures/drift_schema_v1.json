  "fixed_sql": [
    {
      "name": "chat_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_sessions\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"mode\" TEXT NOT NULL DEFAULT 'guided', \"stage\" TEXT NOT NULL DEFAULT 'diagnosing', \"draft\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chat_messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_messages\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES chat_sessions (id) ON DELETE CASCADE, \"role\" TEXT NOT NULL CHECK (role IN ('user','assistant')), \"content\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'complete', \"error\" TEXT NULL, \"model\" TEXT NULL, \"total_tokens\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES chat_sessions (id) ON DELETE CASCADE, \"message_id\" TEXT NULL REFERENCES chat_messages (id) ON DELETE CASCADE, \"relative_path\" TEXT NOT NULL, \"mime\" TEXT NOT NULL, \"byte_length\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "provider_configs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"provider_configs\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"kind\" TEXT NOT NULL DEFAULT 'deepseek', \"base_url\" TEXT NOT NULL DEFAULT 'https://api.deepseek.com', \"model\" TEXT NOT NULL DEFAULT 'deepseek-flash', \"vision\" INTEGER NOT NULL DEFAULT 1 CHECK (\"vision\" IN (0, 1)), \"thinking\" INTEGER NOT NULL DEFAULT 0 CHECK (\"thinking\" IN (0, 1)), \"supports_thinking\" INTEGER NOT NULL DEFAULT 1 CHECK (\"supports_thinking\" IN (0, 1)), \"effort\" TEXT NOT NULL DEFAULT 'high', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"name\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    }
  ]
