#!/usr/bin/env bash
set -euo pipefail

warn_bytes=$((20 * 1024))
high_bytes=$((40 * 1024))
growth_bytes=$((2 * 1024))

is_code_file() {
  case "$1" in
    *.dart|*.py|*.sh|*.bash|*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.java|*.kt|*.kts|*.c|*.h|*.cc|*.cpp|*.hpp|*.rs|*.go|*.rb|*.php|*.swift|*.sql|*.lua|*.pl|*.R|*.r|*.scala|*.sc|*.cs|*.fs|*.ex|*.exs|*.erl|*.hrl|*.clj|*.cljs|*.cljc|*.hs|*.lhs|*.elm|*.vue|*.svelte) ;;
    *) return 1 ;;
  esac

  case "${1##*/}" in
    *.lock|*.g.dart|*.freezed.dart|*.mocks.dart|*.gr.dart) return 1 ;;
  esac
  case "/$1/" in
    */generated/*|*/generated_migrations/*|*/build/*|*/.dart_tool/*|*/vendor/*|*/node_modules/*) return 1 ;;
  esac
  return 0
}

warnings=()

while IFS= read -r -d '' path; do
  is_code_file "$path" || continue

  warn=$warn_bytes
  high=$high_bytes
  case "$path" in
    test/*|integration_test/*|scripts/tests/*)
      warn=$((40 * 1024))
      high=$((80 * 1024))
      ;;
  esac

  size=$(git cat-file -s ":$path")
  if ! previous=$(git cat-file -s "HEAD:$path" 2>/dev/null); then
    previous=0
  fi

  ((size > warn && size > previous)) || continue
  growth=$((size - previous))

  if ((previous <= warn ||
        (previous < high && size >= high) ||
        growth >= growth_bytes)); then
    level="WARNING"
    ((size >= high)) && level="HIGH"
    warnings+=("$level: $path ($size bytes, +$growth)")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#warnings[@]})); then
  printf 'Code size advisory:\n' >&2
  printf '  %s\n' "${warnings[@]}" >&2
  printf '\nReview cohesion and responsibilities if appropriate.\n' >&2
  printf 'Do not split files solely to satisfy size thresholds.\n' >&2
fi

exit 0
