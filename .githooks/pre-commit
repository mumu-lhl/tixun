#!/usr/bin/env bash
set -euo pipefail

limit_bytes=$((20 * 1024))
violations=()

is_code_file() {
  case "$1" in
    *.dart|*.py|*.sh|*.bash|*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.java|*.kt|*.kts|*.c|*.h|*.cc|*.cpp|*.hpp|*.rs|*.go|*.rb|*.php|*.swift|*.sql|*.lua|*.pl|*.R|*.r|*.scala|*.sc|*.cs|*.fs|*.ex|*.exs|*.erl|*.hrl|*.clj|*.cljs|*.cljc|*.hs|*.lhs|*.elm|*.vue|*.svelte)
      ;;
    *) return 1 ;;
  esac

  case "${1##*/}" in
    *.lock|package-lock.json|pnpm-lock.yaml|yarn.lock|Gemfile.lock|Cargo.lock|composer.lock|Pipfile.lock|poetry.lock|*.g.dart|*.freezed.dart|*.mocks.dart|*.gr.dart) return 1 ;;
  esac
  case "/$1/" in
    */generated/*|*/generated_migrations/*|*/build/*|*/.dart_tool/*|*/vendor/*|*/node_modules/*) return 1 ;;
  esac
  return 0
}

while IFS= read -r -d '' path; do
  is_code_file "$path" || continue
  size=$(git cat-file -s ":$path")
  if (( size > limit_bytes )); then
    violations+=("$path ($size bytes)")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#violations[@]})); then
  printf '提交已拦截：以下代码文件超过 20 KiB（20480 字节）：\n' >&2
  printf '  %s\n' "${violations[@]}" >&2
  printf '请拆分文件，或调整职责后再提交。\n' >&2
  exit 1
fi
